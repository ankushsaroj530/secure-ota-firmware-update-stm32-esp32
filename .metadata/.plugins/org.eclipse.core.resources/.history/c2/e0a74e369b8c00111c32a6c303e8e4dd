/**
 * @brief  The application entry point.
 * @retval int
 */
int main(void)
{
    /* USER CODE BEGIN 1 */

    /* USER CODE END 1 */

    /* MCU Configuration--------------------------------------------------------*/

    HAL_Init();

    /* Configure the system clock */
    SystemClock_Config();

    /* Initialize all configured peripherals */
    MX_GPIO_Init();
    MX_USART1_UART_Init();

    /* USER CODE BEGIN 2 */

    uint8_t cmd = 0;
    uint32_t FlashAddress = APP_ADDRESS;

    /* FIX: tracks a command byte that was received during the 5s
     * "wait for host" window, so it is never silently discarded. */
    uint8_t havePendingCmd = 0;

    FirmwareInfo_t CurrentFirmwareInfo;

    /* DEBUG: confirm bootloader entry immediately, before anything else */
    printf("\r\n[BOOT] Bootloader Started\r\n");

    /*
     * Load installed firmware information
     * from Flash memory
     */
    FirmwareInfo_Load(&CurrentFirmwareInfo);

    /*
     * First time bootloader execution
     * Flash contains 0xFFFFFFFF
     */
    if (CurrentFirmwareInfo.version == 0xFFFFFFFF)
    {
        CurrentFirmwareInfo.version = 0;
    }

    /* Read OTA request flag once */
    uint8_t otaRequested = Bootloader_IsUpdateRequested();

    /* DEBUG: show exactly what the flag check returned */
    printf("[BOOT] otaRequested = %d (reserved = 0x%02X)\r\n",
           otaRequested, CurrentFirmwareInfo.reserved);

    if (otaRequested)
    {
        printf("[BOOT] OTA Update Requested\r\n");

        /*
         * FIX: Do NOT clear/save the OTA flag here.
         *
         * Previously the flag was cleared and written to flash
         * immediately, *before* the bootloader ever announced
         * readiness. Two problems with that:
         *
         *   1. A flash erase/write here happens silently before
         *      "BOOTLOADER_READY" is ever printed. If that write
         *      stalls for any reason, the bootloader hangs with
         *      zero output on the wire -- indistinguishable from
         *      "bootloader not detected" on the host side.
         *
         *   2. It is logically premature: if the update session
         *      never completes (host disconnect, power loss,
         *      failed CRC, etc.), the flag is already gone, so a
         *      future reset falls back to the old app instead of
         *      retrying bootloader mode.
         *
         * The flag is now cleared only on confirmed success, in
         * the CMD_END handler below (which already did this
         * correctly).
         */

        goto bootloader_mode;
    }

    /*
     * Wait for update command for 5 seconds
     */
    if (HAL_UART_Receive(&huart1, &cmd, 1, 10) == HAL_TIMEOUT)
    {
        uint32_t appStack;
        uint32_t appEntry;

        appStack = *(__IO uint32_t *)APP_ADDRESS;
        appEntry = *(__IO uint32_t *)(APP_ADDRESS + 4);

        printf("\r\n=========== Bootloader ===========\r\n");
        printf("APP ADDRESS : 0x%08X\r\n", APP_ADDRESS);
        printf("APP STACK   : 0x%08lX\r\n", appStack);
        printf("APP ENTRY   : 0x%08lX\r\n", appEntry);

        if (((appStack & 0x2FFE0000U) == 0x20000000U) &&
            (appEntry != 0xFFFFFFFFU) &&
            (appEntry != 0x00000000U))
        {
            printf("Application Found\r\n");

            HAL_Delay(100);

            Bootloader_JumpToApplication();
        }
        else
        {
            printf("No Valid Application\r\n");
        }
    }
    else
    {
        /* FIX: a byte WAS received within the 5s window (not a timeout).
         * This byte is no longer discarded. It is kept in `cmd` and
         * `havePendingCmd` is set, so the very first iteration of the
         * bootloader_mode while(1) loop below processes it directly
         * instead of issuing a fresh HAL_UART_Receive and losing it. */
        printf("[BOOT] Byte received during wait window: 0x%02X\r\n", cmd);

        havePendingCmd = 1;
    }

    bootloader_mode:

    uint8_t updateInProgress = 0;

    printf("BOOTLOADER_READY\r\n");

    HAL_Delay(50);

    while (1)
    {
        /* FIX: consume a pending byte (captured during the 5s wait
         * window) before trying to receive a new one. */
        if (havePendingCmd)
        {
            havePendingCmd = 0;
        }
        else
        {
            /* Wait for command */
            if(HAL_UART_Receive(&huart1, &cmd, 1, HAL_MAX_DELAY) != HAL_OK)
            {
                continue;
            }
        }

        switch(cmd)
        {

        /********************************************************
         * GET INSTALLED VERSION
         ********************************************************/
        case CMD_GET_VERSION:
        {
            char msg[32];

            FirmwareInfo_Load(&CurrentFirmwareInfo);

            if(CurrentFirmwareInfo.version == 0xFFFFFFFF)
                CurrentFirmwareInfo.version = 0;

            sprintf(msg, "VERSION:%lu\r\n", CurrentFirmwareInfo.version);

            HAL_UART_Transmit(&huart1, (uint8_t *)msg, strlen(msg), HAL_MAX_DELAY);

            break;
        }

        /********************************************************
         * START UPDATE
         ********************************************************/
        case CMD_UPDATE:
        {
            updateInProgress = 0;

            printf("CMD_UPDATE Received\r\n");

            Protocol_SendACK();

            printf("Waiting for Header...\r\n");

            HAL_StatusTypeDef status = Protocol_ReceiveHeader();

            printf("ReceiveHeader Status = %d\r\n", status);

            if(status != HAL_OK)
            {
                printf("Header Receive Failed\r\n");

                Protocol_SendNACK();

                HAL_Delay(200);

                printf("Jumping to existing application...\r\n");

                Bootloader_JumpToApplication();

                while(1);
            }

            printf("Header Received Successfully\r\n");
            printf("Size      : %lu\r\n", gFirmwareHeader.firmwareSize);
            printf("Version   : %lu\r\n", gFirmwareHeader.firmwareVersion);
            printf("CRC       : 0x%08lX\r\n", (unsigned long)gFirmwareHeader.firmwareCRC);
            printf("Device ID : %lu\r\n", gFirmwareHeader.deviceID);

            printf("Auth Token : ");
            for(uint8_t i = 0; i < 16; i++)
            {
                printf("%c", gFirmwareHeader.authToken[i]);
            }
            printf("\r\n");

            /************************************************
             * DEVICE AUTHENTICATION
             ************************************************/

            if(gFirmwareHeader.deviceID != DEVICE_ID)
            {
                printf("Invalid Device ID\r\n");

                Protocol_SendNACK();

                HAL_Delay(200);

                printf("Jumping to existing application...\r\n");

                Bootloader_JumpToApplication();

                while(1);
            }

            if(memcmp(gFirmwareHeader.authToken, BootloaderAuthToken, 16) != 0)
            {
                printf("Authentication Failed\r\n");

                UpdateLog_Print(
                    CurrentFirmwareInfo.version,
                    gFirmwareHeader.firmwareVersion,
                    gFirmwareHeader.deviceID,
                    0,      // Authentication FAIL
                    0,
                    0,
                    0,
                    0       // FAILED
                );
                Protocol_SendNACK();

                HAL_Delay(200);

                printf("Jumping to existing application...\r\n");

                Bootloader_JumpToApplication();

                while(1);
            }

            printf("Authentication Successful\r\n");

            /************************************************
             * VERSION CHECK
             ************************************************/

            FirmwareInfo_Load(&CurrentFirmwareInfo);

            if(CurrentFirmwareInfo.version == 0xFFFFFFFF)
            {
                CurrentFirmwareInfo.version = 0;
            }

            printf("Installed Version : %lu\r\n", CurrentFirmwareInfo.version);

            if(gFirmwareHeader.firmwareVersion <= CurrentFirmwareInfo.version)
            {
                printf("Firmware Rejected (Older Version)\r\n");

                Protocol_SendNACK();

                HAL_Delay(200);

                printf("Jumping to existing application...\r\n");

                Bootloader_JumpToApplication();

                while(1);
            }

            /************************************************
             * START UPDATE
             ************************************************/

            Protocol_SendACK();

            if(Flash_Unlock() != HAL_OK)
            {
                printf("Flash Unlock Failed\r\n");

                Protocol_SendNACK();

                while(1);
            }

            for(uint32_t addr = APP_ADDRESS; addr < FW_INFO_ADDRESS; addr += 1024)
            {
                if(Flash_ErasePage(addr) != HAL_OK)
                {
                    Flash_Lock();

                    printf("Erase Failed\r\n");

                    Protocol_SendNACK();

                    goto update_abort;
                }
            }

            Flash_Lock();

            FlashAddress = APP_ADDRESS;

            updateInProgress = 1;

            printf("Application Area Erased\r\n");

            Protocol_SendACK();

            break;
        }

        /********************************************************
         * RECEIVE DATA
         ********************************************************/
        case CMD_DATA:
        {
            uint16_t length = 0;

            if(updateInProgress == 0)
            {
                Protocol_SendNACK();
                break;
            }

            if(HAL_UART_Receive(&huart1, (uint8_t *)&length, 2, HAL_MAX_DELAY) != HAL_OK)
            {
                Protocol_SendNACK();
                break;
            }

            if(Protocol_ReceivePacket(length) != HAL_OK)
            {
                Protocol_SendNACK();
                break;
            }

            if(Flash_Unlock() != HAL_OK)
            {
                Protocol_SendNACK();
                break;
            }

            if(Flash_WriteBuffer(FlashAddress, PacketBuffer, length) != HAL_OK)
            {
                Flash_Lock();
                Protocol_SendNACK();
                break;
            }

            if(Flash_VerifyBuffer(FlashAddress, PacketBuffer, length) != HAL_OK)
            {
                Flash_Lock();
                printf("Verify Failed @ 0x%08lX\r\n", (unsigned long)FlashAddress);

                Protocol_SendNACK();
                break;
            }

            FlashAddress += length;

            Flash_Lock();

            Protocol_SendACK();

            break;
        }

        /********************************************************
         * UPDATE COMPLETE
         ********************************************************/
        case CMD_END:
        {
            uint32_t crc;
            uint8_t hash[32];

            if(updateInProgress == 0)
            {
                Protocol_SendNACK();
                break;
            }

            crc = CRC32_CalculateFlash(APP_ADDRESS, gFirmwareHeader.firmwareSize);

            SHA256_CalculateFlash(APP_ADDRESS, gFirmwareHeader.firmwareSize, hash);

            if((crc != gFirmwareHeader.firmwareCRC) ||
               (memcmp(hash, gFirmwareHeader.sha256, 32) != 0))
            {
                UpdateLog_Print(
                    CurrentFirmwareInfo.version,
                    gFirmwareHeader.firmwareVersion,
                    gFirmwareHeader.deviceID,
                    1,
                    1,
                    0,
                    0,
                    0
                );
                printf("CRC/SHA Failed\r\n");

                Protocol_SendNACK();

                updateInProgress = 0;

                break;
            }

            printf("CRC PASS\r\n");
            printf("SHA PASS\r\n");

            /* Save firmware information */
            CurrentFirmwareInfo.version  = gFirmwareHeader.firmwareVersion;
            CurrentFirmwareInfo.crc      = gFirmwareHeader.firmwareCRC;
            CurrentFirmwareInfo.deviceID = gFirmwareHeader.deviceID;
            CurrentFirmwareInfo.reserved = UPDATE_FLAG_CLEAR;

            FirmwareInfo_Save(&CurrentFirmwareInfo);

            Protocol_SendACK();

            HAL_UART_Transmit(&huart1, (uint8_t *)"LOG:Device ID = 1\r\n",
                              strlen("LOG:Device ID = 1\r\n"), HAL_MAX_DELAY);

            HAL_UART_Transmit(&huart1, (uint8_t *)"LOG:Authentication = PASS\r\n",
                              strlen("LOG:Authentication = PASS\r\n"), HAL_MAX_DELAY);

            HAL_UART_Transmit(&huart1, (uint8_t *)"LOG:Status = SUCCESS\r\n",
                              strlen("LOG:Status= SUCCESS\r\n"), HAL_MAX_DELAY);

            HAL_UART_Transmit(&huart1, (uint8_t *)"LOG: END\r\n",
                              strlen("LOG: END\r\n"), HAL_MAX_DELAY);

            while (__HAL_UART_GET_FLAG(&huart1, UART_FLAG_TC) == RESET)
            {
            }

            printf("Firmware Update Successful\r\n");
            printf("Flash Version  : %lu\r\n", *(volatile uint32_t *)FW_INFO_ADDRESS);
            printf("Flash CRC      : 0x%08lX\r\n", *(volatile uint32_t *)(FW_INFO_ADDRESS + 4));
            printf("Flash DeviceID : %lu\r\n", *(volatile uint32_t *)(FW_INFO_ADDRESS + 8));
            printf("Flash Flag     : 0x%08lX\r\n", *(volatile uint32_t *)(FW_INFO_ADDRESS + 12));

            HAL_Delay(100);

            NVIC_SystemReset();

            break;
        }

        /********************************************************
         * EXIT
         ********************************************************/
        case CMD_EXIT:
        {
            Protocol_SendACK();

            HAL_Delay(1000);

            Bootloader_JumpToApplication();

            break;
        }

        /********************************************************
         * UNKNOWN COMMAND
         ********************************************************/
        default:
        {
            printf("Unknown CMD : 0x%02X\r\n", cmd);
            Protocol_SendNACK();
            break;
        }

        }

    update_abort:
        ;
    }
}

